PORT=4000
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
USE_DATABASE_URL=false
# Deja que TypeORM cree/altere tablas solo. Comodo en local, PELIGROSO en
# produccion: un renombre de columna lo resuelve con DROP + ADD.
# En produccion dejar en false y aplicar los scripts de migrations/.
DB_SYNCHRONIZE=true
FRONTEND_URLS=http://localhost:5173
ALLOW_VERCEL_PREVIEWS=false

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=cayman_bank

# Render/Supabase/Neon/etc. Use only when USE_DATABASE_URL=true.
DATABASE_URL=postgresql://user:password@host:5432/database

CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

CENTRAL_BANK_URL=https://centralbank.brocoly.cc/api
CENTRAL_BANK_API_KEY=your_central_bank_api_key
CENTRAL_BANK_ENV=test
BANK_ID=your_bank_id
BANK_CODE=19
BANK_NAME=Cayman-Shadow-Bank

# ---------------------------------------------------------------- Asistente IA
# Proveedor del modelo: anthropic o gemini. Sin la key del proveedor elegido,
# /chat/mensajes responde 503; el resto del banco funciona igual.
CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# Key gratuita en https://aistudio.google.com (el plan gratis tiene limite de uso).
GEMINI_API_KEY=
# Opcional. Por defecto: claude-opus-5 con anthropic. Con gemini acepta una lista
# separada por comas que se prueba en orden si un modelo esta saturado
# (por defecto gemini-3.8-flash,gemini-3.5-flash,gemini-3.1-flash-lite).
CHAT_MODEL=
# Mensajes por visitante (IP) por hora en el chat publico de la landing.
CHAT_LIMITE_POR_HORA=20

# ------------------------------------------------------------ Tarjetas
# La catedra asigna el rango de BIN por grupo; hasta entonces es un placeholder.
CARD_BIN=450019
CARD_TNA=0.85
CARD_PAGO_MINIMO_PCT=0.1
CARD_DIA_VENCIMIENTO=10

# ------------------------------------------------------------ Prestamos
# Peor situacion crediticia aceptada para otorgar (1=normal ... 5=irrecuperable).
LOAN_MAX_SITUACION=2
LOAN_TNA_DEFAULT=0.7

# ------------------------------------------------------------ Inversiones
FIXED_TERM_MIN=1000
FIXED_TERM_MIN_DAYS=30
FIXED_TERM_TNA_DEFAULT=0.3

# ------------------------------------------------------------ Recargas
TOPUP_MIN=100
TOPUP_MAX=50000

# ------------------------------------------- APIs publicas externas (tienen default)
DOLAR_API_URL=https://dolarapi.com/v1/dolares
DOLAR_CASA=oficial
RATES_PRESTAMOS_URL=https://api.argentinadatos.com/v1/finanzas/creditos/prestamosPersonales
RATES_PLAZO_FIJO_URL=https://api.argentinadatos.com/v1/finanzas/tasas/plazoFijo
RATES_UVA_URL=https://api.argentinadatos.com/v1/finanzas/indices/uva
CEDEARS_URL=https://data912.com/live/arg_cedears
