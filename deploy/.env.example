# Configuracion del servidor. Copiar a deploy/.env y completar.
# deploy/.env tiene secretos: NO se commitea (esta en .gitignore).

# ------------------------------------------------------------ Direccion publica
# Con dominio (recomendado: HTTPS automatico, y Clerk lo necesita):
#   SITIO=cayman.ejemplo.com
#   URL_PUBLICA=https://cayman.ejemplo.com
# Solo con la IP del droplet (HTTP plano, para una primera prueba):
#   SITIO=:80
#   URL_PUBLICA=http://203.0.113.10
SITIO=
URL_PUBLICA=

# ------------------------------------------------------------ Base de datos
# Generar una larga, por ejemplo: openssl rand -hex 24
POSTGRES_PASSWORD=

# ------------------------------------------------------------ Clerk (login)
# Las usan el backend y el frontend.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ------------------------------------------------------------ Banco Central
CENTRAL_BANK_URL=https://centralbank.brocoly.cc/api
CENTRAL_BANK_API_KEY=
CENTRAL_BANK_ENV=test
BANK_CODE=19
BANK_NAME=Cayman-Shadow-Bank

# ------------------------------------------------------------ Asistente IA
CHAT_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Mensajes por visitante (IP) por hora en el chat de la landing.
CHAT_LIMITE_POR_HORA=20

# El resto (tarjetas, prestamos, plazos fijos, recargas, APIs publicas) tiene
# valores por defecto en el codigo; ver cayman-backend/.env.example si hace
# falta cambiar alguno.
